          "queryType": "traceql",
          "query": "{resource.service.name=\"claude-code\" && span.\"user.email\" =~ \"($user_email|unknown)\" && span.\"session.id\" =~ \"$session_id\" && trace:duration > ${trace_min_duration} && status = error}",
