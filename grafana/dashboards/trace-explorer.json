  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "claude-code,claude-code-desktop,claude-code.*",
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "claude-code",
          "value": "claude-code",
          "selected": true
        },
        "options": [
          {
            "text": "claude-code",
            "value": "claude-code",
            "selected": true
          },
          {
            "text": "claude-code-desktop",
            "value": "claude-code-desktop",
            "selected": false
          },
          {
            "text": "both",
            "value": "claude-code.*",
            "selected": false
          }
        ]
      },
      {
        "name": "session_id",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "definition": "query_result(sum by (session_id) (count_over_time({service_name=~\"$service\"} | session_id =~ \".+\" [$__range])))",
        "query": "query_result(sum by (session_id) (count_over_time({service_name=~\"$service\"} | session_id =~ \".+\" [$__range])))",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "options": [],
        "regex": "/.*session_id=\"([^\"]+)\".*/",
        "current": {
          "text": "All",
          "value": ".*",
          "selected": true
        }
      },
      {
        "name": "trace_min_duration",
        "label": "Min Duration",
        "type": "custom",
        "definition": "0s,100ms,500ms,1s,5s,10s",
        "query": "0s,100ms,500ms,1s,5s,10s",
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "0s",
          "selected": true
        },
        "options": [
          {
            "text": "All",
            "value": "0s",
            "selected": true
          },
          {
            "text": ">100ms",
            "value": "100ms",
            "selected": false
          },
          {
            "text": ">500ms",
            "value": "500ms",
            "selected": false
          },
          {
            "text": ">1s",
            "value": "1s",
            "selected": false
          },
          {
            "text": ">5s",
            "value": "5s",
            "selected": false
          },
          {
            "text": ">10s",
            "value": "10s",
            "selected": false
          }
        ]
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "hide": 0,
        "query": "",
        "options": [],
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 900,
      "type": "text",
      "title": "Trace exploration guidance",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "### Trace Explorer\nTrace search is **session-aware**. Arrive here from **Entity Detail** with `Service`/`Session` already scoped, or narrow the `Session` variable directly. The **Trace List** is the source of truth — its result set also feeds the summary stat and the Duration Distribution histogram, so there is only one Tempo search. **Click a `traceID`** in the list to load its **Trace Timeline** below (the timeline stays empty until you select or paste a trace ID — a blank ID is harmless). Spans here carry no `user.email` (single-user stack), so there is no User filter; scope is `Service` + `Session` only.",
        "mode": "markdown"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Trace Samples",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "-- Dashboard --"
          },
          "panelId": 5,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "displayName",
                "value": "Trace Count"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "Number of traces in the current Trace List result (shared query, no extra Tempo search). Reflects the Service/Session/Min Duration scope.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "traceDuration"
              ]
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg Trace Duration",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "-- Dashboard --"
          },
          "panelId": 5,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Avg Duration"
              },
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "Mean duration of the traces in the current Trace List scope (shared query with the list, no extra Tempo search).",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "traceDuration"
              ]
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Trace List",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "tempo",
        "uid": "P214B5B846CF3925F"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "P214B5B846CF3925F"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name=~\"$service\" && span.session.id=~\"$session_id\" && trace:duration > ${trace_min_duration} }",
          "tableType": "traces",
          "limit": 50,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Load Trace Timeline (below)",
                    "url": "/d/cc-trace-explorer?var-service=${service}&var-session_id=${session_id}&var-trace_id=${__value.raw}&var-trace_min_duration=${trace_min_duration}&${__url_time_range}",
                    "targetBlank": false
                  },
                  {
                    "title": "Open Entity Detail",
                    "url": "/d/cc-session-explorer?var-service=${service}&var-session_id=${session_id}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 280
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "startTimeUnixNano"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "startTimeUnixNano",
            "desc": true
          }
        ],
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "countRows": true
        }
      },
      "transformations": [],
      "description": "Traces for the current Service/Session search. Click a traceID to load its timeline below, or jump to Entity Detail. This panel is the shared source query for the summary stat and the histogram."
    },
    {
      "id": 6,
      "type": "traces",
      "title": "Trace Timeline",
      "description": "Empty until a trace is selected. Click a traceID in the Trace List above (sets the Trace ID variable) or paste one into the Trace ID textbox. A blank Trace ID renders an empty panel and does not error.",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "tempo",
        "uid": "P214B5B846CF3925F"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "P214B5B846CF3925F"
          },
          "queryType": "traceql",
          "query": "${trace_id}",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 8,
      "type": "histogram",
      "title": "Duration Distribution",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "-- Dashboard --"
          },
          "panelId": 5,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "bucketSize": 1000,
        "combine": true,
        "fillOpacity": 80,
        "gradientMode": "scheme",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Distribution of trace durations across the current Trace List sample (shared query, no extra Tempo search).",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "traceDuration"
              ]
            }
          }
        }
      ]
    }
  ]
}
