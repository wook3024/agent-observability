    {
      "id": 1,
      "type": "stat",
      "title": "5h Cost",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(increase(claude_code_cost_usage_USD_total{exported_job=~\"$service\", model=~\"$model\"}[5h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "Cost accrued in the trailing 5-hour window — proxy for Claude's 5h session limit (the real meter unit is undisclosed; USD already weights model and cache pricing). increase() misses usage accumulated before a session's first 15s scrape, so treat as a tight lower bound."
    },
