    {
      "id": 40,
      "type": "gauge",
      "title": "5h Window Used",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "claude_code_rate_limit_used_percent{exported_job=\"claude-usage-statusline\", window=\"five_hour\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 55
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "description": "REAL limit utilization for the five_hour window, as reported by Claude Code itself (same number as /usage). Shipped from the statusline via scripts/ship-rate-limit-metrics.sh -> OTLP. Only collected while Claude Code is running; series expires ~5m after the last session closes (honest 'No data')."
    },
