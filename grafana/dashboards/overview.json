        "query": "claude-code,claude-code-desktop,claude-code.*",
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "claude-code",
          "value": "claude-code",
          "selected": true
        },
        "options": [
          {
            "text": "claude-code",
            "value": "claude-code",
            "selected": true
