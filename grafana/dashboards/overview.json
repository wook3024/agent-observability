          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "links": [
            {
              "title": "Open Activity & Cost",
              "url": "/d/cc-activity?var-service=${service}&var-session_id=${session_id}&var-prompt_id=${prompt_id}&var-model=${model}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "Share of api_request cost attributed to query_source=subagent (baseline ≈ 26%). A spike means delegated agents are dominating spend."
    },
