      "targets": [
        {
          "refId": "A",
          "expr": "(sum(sum_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | model=~\"$model\" | event_name = `api_request` | query_source =~ `agent:.*` | unwrap cost_usd [$__range])) / sum(sum_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | model=~\"$model\" | event_name = `api_request` | unwrap cost_usd [$__range])) * 100) or vector(0)"
