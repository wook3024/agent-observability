  "panels": [
    {
      "id": 900,
      "type": "text",
      "title": "How to use this overview",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "### Executive Overview — glance, then drill\nThe **canary row** carries regression-style signals built only on telemetry that is actually populated for Claude Code: tool failure rate, cache efficiency, and subagent cost share. Use it to decide where to go next via the nav bar (**Activity & Cost**, **Tools & Edits**, **Events Explorer**, **Entity Detail**, **Trace Explorer**). The **Session Investigation Queue** ranks sessions so you can drill without typing IDs. Absolute spend and run-rate cards live in the collapsed **Run-rate** row at the bottom (those use fixed time windows and ignore the time picker).\n\n_Note: this stack currently has a single user; log `user_email` is always `unknown`, so there is no User filter. `api_error` is not emitted by this Claude Code build — reliability is tracked via tool failures instead._",
        "mode": "markdown"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Sessions in Scope",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (session_id) (count_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" [$__range]))) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "links": [
            {
              "title": "Open Entity Detail",
              "url": "/d/cc-session-explorer?var-service=${service}&var-session_id=${session_id}&var-prompt_id=${prompt_id}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "Distinct sessions in the current investigation context."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Cost in Scope",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | model=~\"$model\" | event_name = `api_request` | unwrap cost_usd [$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "links": [
            {
              "title": "Open Activity & Cost",
              "url": "/d/cc-activity?var-service=${service}&var-session_id=${session_id}&var-prompt_id=${prompt_id}&var-model=${model}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "Spend (api_request cost_usd) for the active scope. This honors the time picker; absolute run-rate is in the collapsed row below."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tool Failure Rate",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(count_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | tool_name=~\"$tool_name\" | event_name = `tool_result` | success = `false` [$__range])) / sum(count_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | tool_name=~\"$tool_name\" | event_name = `tool_result` [$__range])) * 100) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "links": [
            {
              "title": "Open Tools & Edits",
              "url": "/d/cc-tool-analytics?var-service=${service}&var-session_id=${session_id}&var-prompt_id=${prompt_id}&var-tool_name=${tool_name}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "Share of tool_result events with success=false. The real reliability canary (baseline ≈ 2.6%); api_error is not emitted by this build."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P95 API Latency",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(quantile_over_time(0.95, {service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | model=~\"$model\" | event_name = `api_request` | unwrap duration_ms [$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "links": [
            {
              "title": "Open Activity & Cost",
              "url": "/d/cc-activity?var-service=${service}&var-session_id=${session_id}&var-prompt_id=${prompt_id}&var-model=${model}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "95th percentile api_request duration. With one stream per service this is the service p95 (max collapses multiple services to the worst)."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache Hit Efficiency",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(sum_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | model=~\"$model\" | event_name = `api_request` | unwrap cache_read_tokens [$__range])) / (sum(sum_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | model=~\"$model\" | event_name = `api_request` | unwrap cache_read_tokens [$__range])) + sum(sum_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | model=~\"$model\" | event_name = `api_request` | unwrap input_tokens [$__range])) + sum(sum_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | model=~\"$model\" | event_name = `api_request` | unwrap cache_creation_tokens [$__range]))) * 100) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          },
          "links": [
            {
              "title": "Open Activity & Cost",
              "url": "/d/cc-activity?var-service=${service}&var-session_id=${session_id}&var-prompt_id=${prompt_id}&var-model=${model}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "cache_read / (cache_read + input + cache_creation) tokens. A drop means the prompt cache is being underused, which inflates cost and latency."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Subagent Cost Share",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 3
      },
      "datasource": {
        "type": "loki",
