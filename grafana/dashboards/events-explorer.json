  "panels": [
    {
      "id": 900,
      "type": "text",
      "title": "How to use the Events Explorer",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "### Events Explorer — the raw event search surface\nThis is where you go from a symptom to the exact event. Pick an **Event** (15 real `event_name` values; there is no `api_error` in this build — tool failures are tracked via `tool_result success=false`) and narrow with **Service / Session / Prompt**. The **Event Investigation Queue** is the fastest pivot: click a Session or Prompt to open **Entity Detail**, or click a Trace to jump into the **Trace Explorer** (log↔trace correlation). The full-payload **Raw log stream** lives in the collapsed row at the bottom so it never dominates the view.\n\n_Single-user stack: log `user_email` is always `unknown`, so there is no User filter — scope only by Service / Session / Prompt / Event._",
        "mode": "markdown"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Selected Event Count",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"$service\"} | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | event_name=~\"$event_name\" [$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
