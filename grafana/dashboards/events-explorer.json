  "templating": {
    "list": [
      {
        "name": "user_email",
        "label": "User",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "definition": "label_values(claude_code_session_count_total, user_email)",
        "query": "label_values(claude_code_session_count_total, user_email)",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "session_id",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "definition": "query_result(sum by (session_id) (count_over_time({service_name=\"claude-code\"} | user_email=~\"$user_email\" | session_id =~ \".+\" [$__range])))",
        "query": "query_result(sum by (session_id) (count_over_time({service_name=\"claude-code\"} | user_email=~\"$user_email\" | session_id =~ \".+\" [$__range])))",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "options": [],
        "regex": "/.*session_id=\"([^\"]+)\".*/",
        "current": {
          "text": "All",
          "value": ".*",
          "selected": true
        }
      },
      {
        "name": "prompt_id",
        "label": "Prompt",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
