            "matcher": {
              "id": "byName",
              "options": "tool_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tool"
              },
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "links",
                "value": [
