    {
      "id": 900,
      "type": "text",
      "title": "How to use this draft",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "### Codex CLI Overview\n이 대시보드는 `Codex CLI` telemetry가 현재 스택에 들어왔는지 빠르게 확인하는 초안입니다. 기본 필터는 `service_name`, `user_email`, `originator`, `session_source`, `model`이고, 패널은 `event.name=\\\"codex.*\\\"` 로그를 우선 사용합니다.",
        "mode": "markdown"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Completed Turns",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"$service_name\"} | user_email=~\"$user_email\" | originator=~\"$originator\" | session_source=~\"$session_source\" | model=~\"$model\" |= \"event.name=\\\"codex.sse_event\\\"\" |= \"event.kind=response.completed\" [$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
