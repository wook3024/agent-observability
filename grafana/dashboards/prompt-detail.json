        "definition": "label_values(claude_code_session_count_total, user_email)",
        "query": "label_values(claude_code_session_count_total, user_email)",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
