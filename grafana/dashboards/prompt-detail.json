          "refId": "A",
          "expr": "(max(max_over_time({service_name=\"claude-code\"} | user_email=~\"($user_email|unknown)\" | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | unwrap observed_timestamp [$__range])) - min(min_over_time({service_name=\"claude-code\"} | user_email=~\"($user_email|unknown)\" | session_id=~\"$session_id\" | prompt_id=~\"$prompt_id\" | unwrap observed_timestamp [$__range]))) / 1000000 or vector(0)",
